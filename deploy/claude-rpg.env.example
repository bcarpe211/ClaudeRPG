# Copied to /etc/claude-rpg.env by setup.sh (chmod 600). Edit ADMIN_PASSWORD!
# Runtime Raiders uses this compatibility filename during the internal cutover.
# Port the server listens on.
PORT=8080
# Admin panel login. Username defaults to 'admin' if unset. These are applied on
# every server start (edit + `sudo systemctl restart claude-rpg` to change them).
ADMIN_USERNAME=admin
# Admin panel password — CHANGE THIS.
ADMIN_PASSWORD=change-me-please
# Random string for session cookies — setup.sh generates one if left as-is.
SESSION_SECRET=change-me-too
# Persistent SQLite path + sprite dir are set to absolute repo paths by setup.sh.
DB_PATH=__REPO__/data/claude-rpg.db
SPRITES_DIR=__REPO__/assets/oryx_16-bit_fantasy_1.1/Sliced
# Runtime Raiders enrollment target. Fresh setup is fail-closed: leave scoring
# disabled until the authorized cutover installs a reviewed non-placeholder
# timestamp and explicitly changes the mode.
PUBLIC_URL=https://raiders.redlattice.com
SCORING_MODE=disabled
RUN_SCORING_CUTOVER_AT=1800000000000
# setup.sh substitutes __REPO__ with the absolute checked-in repository path.
RAID_POWER_POLICY_PATH=__REPO__/config/raid-power-policy-v1.json
RAID_POWER_POLICY_V2_PATH=__REPO__/config/raid-power-policy-v2.json
RAID_POWER_V2_CUTOVER_AT=1800000000000
RUN_ENABLED_SURFACES=codex_desktop,codex_cli
