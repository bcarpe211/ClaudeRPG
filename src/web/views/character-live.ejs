<div class="hub-panel-head">
  <div><h2>Current Raid</h2><p>The same battle playing on the office TV, packed into your field journal.</p></div>
  <a href="/tv" class="btn btn-ghost">Watch full screen</a>
</div>
<div class="hub-live-grid">
  <div class="hub-dungeon">
    <iframe class="hub-dungeon-frame" src="/tv/embed" title="Current Runtime Raiders dungeon"></iframe>
  </div>

  <section class="hub-subpanel hub-fight-leaders" aria-labelledby="hub-leaders-title">
    <h3 id="hub-leaders-title">Fight Leaders</h3>
    <div id="hub-leaders" tabindex="0" aria-labelledby="hub-leaders-title">
      <% if (currentFight.leaders.length > 0) { %>
        <ol class="hub-leaders">
          <% currentFight.leaders.forEach(function (leader, index) { %>
            <li><span class="hub-leaders-rank">#<%= index + 1 %></span><span class="hub-leaders-name"><%= leader.name %></span><span class="hub-leaders-damage"><%= leader.damage.toLocaleString('en-US') %> dmg</span></li>
          <% }); %>
        </ol>
      <% } else { %>
        <p class="hub-empty-line">The damage ledger is waiting for its first mark.</p>
      <% } %>
    </div>
  </section>

  <section class="hub-today-panel" aria-labelledby="hub-today-title">
    <h3 id="hub-today-title">Today</h3>
    <div class="hub-today">
      <div class="hub-today-card"><span>Raid Power</span><strong id="hub-today-tokens"><%= today.raidPower.toLocaleString('en-US') %></strong></div>
      <div class="hub-today-card"><span>Damage</span><strong id="hub-today-damage"><%= today.damage.toLocaleString('en-US') %></strong></div>
      <div class="hub-today-card"><span>Fight rank</span><strong id="hub-today-rank"><%= today.fightRank == null ? '—' : '#' + today.fightRank %></strong></div>
      <div class="hub-today-card"><span>Gold earned</span><strong id="hub-today-gold"><%= today.goldEarned.toLocaleString('en-US') %>g</strong></div>
      <div class="hub-today-card"><span>Raid time</span><strong id="hub-today-active"><%= Math.floor(today.combatActiveMs / 3600000) %>h <%= Math.floor((today.combatActiveMs % 3600000) / 60000) %>m</strong></div>
      <div class="hub-today-card"><span>Potions used</span><strong id="hub-today-potions"><%= today.potionsUsed %></strong></div>
    </div>
  </section>

  <section class="hub-run-details" aria-labelledby="hub-run-details-title">
    <div class="hub-run-details-head">
      <h3 id="hub-run-details-title">Run Details</h3>
      <span id="hub-active-runs"><%= activeRuns %> <%= activeRuns === 1 ? 'Run' : 'Runs' %> active</span>
    </div>
      <article id="hub-latest-run" class="hub-latest-run"<% if (!latestRun) { %> hidden<% } %>>
        <strong>Latest Run</strong>
        <dl>
          <dt>Provider</dt><dd id="hub-run-provider"><%= latestRun?.provider ?? '—' %></dd>
          <dt>Surface</dt><dd id="hub-run-surface"><%= latestRun?.surface ?? '—' %></dd>
          <dt>Model</dt><dd id="hub-run-model"><%= latestRun?.model ?? '—' %></dd>
          <dt>Effort</dt><dd id="hub-run-effort"><%= latestRun?.effort ?? '—' %></dd>
          <dt>State</dt><dd id="hub-run-state"><%= latestRun ? latestRun.state[0].toUpperCase() + latestRun.state.slice(1) : '—' %></dd>
          <dt>Elapsed</dt><dd id="hub-run-elapsed"><%= latestRun ? Math.floor(latestRun.elapsedMs / 60000) + 'm ' + Math.floor((latestRun.elapsedMs % 60000) / 1000) + 's' : '—' %></dd>
          <dt>Native usage</dt><dd id="hub-run-native-usage"><%= latestRun ? latestRun.nativeUsage.nestedShapeValid ? latestRun.nativeUsage.input.toLocaleString('en-US') + ' total input (' + latestRun.nativeUsage.cacheRead.toLocaleString('en-US') + ' cached, ' + latestRun.nativeUsage.uncachedInput.toLocaleString('en-US') + ' uncached) · ' + latestRun.nativeUsage.output.toLocaleString('en-US') + ' total output (' + latestRun.nativeUsage.reasoningOutput.toLocaleString('en-US') + ' reasoning) · ' + latestRun.nativeUsage.cacheWrite.toLocaleString('en-US') + ' cache writes reported' : latestRun.nativeUsage.input.toLocaleString('en-US') + ' total input (' + latestRun.nativeUsage.cacheRead.toLocaleString('en-US') + ' cached, cache relationship unavailable) · ' + latestRun.nativeUsage.output.toLocaleString('en-US') + ' total output (' + latestRun.nativeUsage.reasoningOutput.toLocaleString('en-US') + ' reasoning) · ' + latestRun.nativeUsage.cacheWrite.toLocaleString('en-US') + ' cache writes reported' : '—' %></dd>
          <dt>Awarded</dt><dd id="hub-run-awarded"><%= latestRun ? latestRun.raidPower.toLocaleString('en-US') + ' Raid Power' : '—' %></dd>
        </dl>
      </article>
      <p id="hub-no-runs" class="hub-empty-line"<% if (latestRun) { %> hidden<% } %>>No Runs recorded yet.</p>
  </section>
</div>
