    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow"><span class="dot"></span> LIVE — the raid is underway</p>
        <h1><%= brand.primaryLine %></h1>
        <p class="lede">A shared dungeon crawl where your private local companion turns Runs into Raid Power for the party.</p>
        <p class="reward-note">Get paid means in-game gold and rewards.</p>
        <div class="cta-row"><a class="btn btn-gold" href="/register"><img class="px bi" src="/static/landing/sword.png" alt=""> Create Your Raider</a><a class="btn btn-ghost" href="/tv">▶ Watch on the TV</a></div>
      </div>
      <aside class="boss-card">
        <% if (boss) { %>
          <div class="boss-head"><span class="tag"><span class="dot"></span>LIVE BATTLE</span><span class="floor"><%= boss.location %></span></div>
          <div class="boss-stage"><div class="boss-glow"></div><img class="px boss-sprite" src="<%= boss.sprite %>" alt="the current boss"></div>
          <div class="boss-name"><img class="px ci" src="/static/landing/crown.png" alt=""> <%= boss.name %></div>
          <div class="hpbar"><span style="width:<%= boss.hpPct %>%"></span></div>
          <div class="hp-meta"><span><img class="px si" src="/static/landing/heart.png" alt=""> <%= boss.hpText %> HP</span><span><%= boss.hpPct %>%</span></div>
          <div class="party"><div class="pty-row"><% boss.avatars.forEach(function(a){ %><span class="pty"><img class="px" src="<%= a %>" alt=""></span><% }); %></div><span><%= boss.count %> Raider<%= boss.count === 1 ? '' : 's' %> contributing</span></div>
        <% } else { %>
          <div class="boss-idle"><img class="px" src="/static/landing/skull.png" alt=""><h3>The dungeon rests</h3><p>No active battle right now &mdash; create your Raider and begin a Run to wake it.</p></div>
        <% } %>
      </aside>
    </section>

    <section class="classes">
      <div class="sec-head"><h2>Choose your Raider&rsquo;s class</h2><p>Nine classic classes, each with its own sprite on the TV. Click one to enlist.</p></div>
      <div class="cls-grid"><% classes.forEach(function(c){ %><a class="cls" href="/register?class=<%= c.key %>"><span class="cls-sprite"><img class="px" src="<%= c.sprite %>" alt="<%= c.name %>"></span><span class="cls-name"><%= c.name %></span><span class="cls-glint"></span></a><% }); %></div>
    </section>

    <section class="how">
      <div class="sec-head"><h2>How your Runs become Raid Power</h2><p>Three quick steps, then your Raider joins the party.</p></div>
      <ol class="steps">
        <li class="step"><span class="step-ico"><img class="px" src="/static/landing/scroll.png" alt=""><b>1</b></span><div><h3>Create your Raider.</h3><p>Choose a name, a look, and a classic class for the TV.</p></div></li>
        <li class="step"><span class="step-ico"><img class="px" src="/static/landing/key.png" alt=""><b>2</b></span><div><h3>Install the private local companion.</h3><p>It enrolls this device with a one-time code and keeps your Raider connected.</p></div></li>
        <li class="step"><span class="step-ico"><img class="px" src="/static/landing/coins.png" alt=""><b>3</b></span><div><h3><%= runStep ?? 'Your Runs generate Raid Power.' %></h3><p>Raid Power helps the party face the shared monster on the office TV.</p></div></li>
      </ol>
      <% if (supportedSurfaceLine) { %><p class="support-line"><img class="px si" src="/static/landing/key.png" alt=""> <%= supportedSurfaceLine %></p><% } %>
    </section>

    <section class="trust">
      <div class="sec-head"><h2>What it extracts &mdash; and what it never sends</h2><p>It scans local provider records for approved Run metadata and usage counters. Work content is not extracted into Run metadata or transmitted.</p></div>
      <div class="trust-cols">
        <div class="tcol sees"><h3><img class="px si" src="/static/landing/gem_green.png" alt=""> Approved Run metadata</h3><p class="privacy-line"><strong>Run metadata:</strong> provider, supported surface, usage counts, model, effort, timestamps, Run state</p></div>
        <div class="tcol nots"><h3><img class="px si" src="/static/landing/shield.png" alt=""> What it never sends</h3><p class="privacy-line"><strong>It never sends:</strong> prompts, responses, commands, tool details, code, files, paths, workspaces, shell history</p></div>
      </div>
    </section>

    <section class="final">
      <div class="final-loot"><img class="px" src="/static/landing/gem_red.png" alt=""><img class="px" src="/static/landing/sword_flame.png" alt=""><img class="px" src="/static/landing/gem_blue.png" alt=""></div>
      <h2>Enter the dungeon.</h2>
      <p>Your next Run can bring gold, rewards, and Raid Power to the whole party.</p>
      <a class="btn btn-gold big" href="/register"><img class="px bi" src="/static/landing/sword.png" alt=""> Create Your Raider</a>
    </section>
