<div class="panel">
  <div style="display:flex;gap:20px;align-items:center;flex-wrap:wrap">
    <div style="flex:0 0 auto;width:112px;height:112px;border-radius:16px;background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--line);display:grid;place-items:center;box-shadow:inset 0 1px 0 #ffffff0d">
      <img id="character-avatar" src="<%= avatarUrl %>" alt="avatar" class="px" style="width:88px;height:88px;filter:drop-shadow(0 8px 10px rgba(0,0,0,.5))" />
    </div>
    <div>
      <h1 style="margin:0 0 6px"><%= player.name %></h1>
      <p style="margin:0;color:var(--muted)"><span style="color:var(--gold2);font-weight:700"><%= className %></span> · <%= player.gender === 'M' ? 'Male' : 'Female' %> · <%= connected ? 'Connected' : 'Not seen yet' %></p>
    </div>
  </div>

  <div class="stat-grid">
    <div class="stat-card"><span class="stat-k">Level</span><span class="stat-v"><%= player.level %></span></div>
    <div class="stat-card"><span class="stat-k">XP (effective tokens)</span><span class="stat-v"><%= player.effective_tokens %></span></div>
    <div class="stat-card"><span class="stat-k">Total tokens</span><span class="stat-v"><%= player.total_tokens %></span></div>
    <div class="stat-card"><span class="stat-k">Gold</span><span class="stat-v" style="color:var(--gold2)"><%= player.gold %></span></div>
  </div>
</div>

<% if (!dye.available) { %>
<div class="panel dye-unavailable">
  <div class="dye-unavailable-art" aria-hidden="true">
    <img class="px" src="<%= avatarUrl %>" width="96" height="96" alt="" />
    <span>✂</span>
  </div>
  <div>
    <p class="dye-kicker">The dungeon tailor</p>
    <h2>Tailoring in progress</h2>
    <p>Your sprite’s dye pattern is still being mapped pixel by pixel. The workbench will open here when it is ready — no gold can be spent before then.</p>
  </div>
</div>
<% } else { %>
<div class="panel dye-panel">
  <div class="dye-head">
    <div>
      <p class="dye-kicker">Your personal dungeon tailor</p>
      <h2>Dye Workbench</h2>
      <p>Wardrobe Tier <%= dye.tier %> · unlocked colors stay free forever.</p>
    </div>
    <% if (dye.nextOffer) { %>
      <a class="btn btn-gold" href="/shop?token=<%= encodeURIComponent(player.auth_token) %>">Unlock the next tier</a>
    <% } else { %>
      <span class="dye-mastery">Dye mastery complete</span>
    <% } %>
  </div>

  <div class="dye-tier-groups" aria-label="Wardrobe tiers">
    <% for (const group of dye.groups) { %>
      <section class="dye-tier-group" data-tier="<%= group.tier %>">
        <div class="dye-tier-group-head">
          <span>Tier <%= group.tier %></span>
          <span class="dye-tier-lock"><%= group.unlocked ? 'Unlocked' : 'Locked' %></span>
        </div>
        <div class="dye-channels">
          <% for (const channel of group.channels) { %>
            <button type="button" class="dye-chan" data-slot="<%= channel.slot %>" data-required-tier="<%= channel.requiredTier %>"<%= group.unlocked ? '' : ' disabled' %> aria-pressed="false">
              <span class="dye-dot is-default" aria-hidden="true"></span><span><%= channel.label %></span>
            </button>
          <% } %>
        </div>
      </section>
    <% } %>
  </div>

  <% if (dye.channels.length > 0) { %>
    <div class="dye-workbench">
      <div class="dye-stage">
        <span class="dye-stage-label">Live fitting</span>
        <canvas id="dye-preview" width="168" height="168" class="px dye-preview" aria-label="Live character dye preview"></canvas>
        <span id="dye-active-label" class="dye-active-label"></span>
      </div>

      <div class="dye-toolbox">
        <div class="dye-section">
          <div class="dye-actions">
            <span id="dye-save-status" class="dye-save-status" role="status" aria-live="polite">Saved</span>
            <button id="dye-reload" type="button" class="btn dye-reload" hidden>Reload Wardrobe</button>
            <button id="dye-discard" type="button" class="btn dye-discard" disabled>Discard Changes</button>
            <button id="dye-save" type="button" class="btn btn-gold" disabled>Save Changes</button>
          </div>
          <div class="dye-paint-row">
            <div class="dye-wheel-section">
              <div class="dye-wheel-frame">
                <canvas id="dye-wheel" width="72" height="72" class="dye-wheel"
                  role="slider" tabindex="0" aria-label="Dye hue"
                  aria-valuemin="0" aria-valuemax="359" aria-valuenow="0"></canvas>
              </div>
              <span class="dye-wheel-help">Drag, click, or use arrow keys</span>
            </div>
            <div class="dye-tone-section">
              <label class="dye-tone-label" for="dye-tone">Tone <output id="dye-tone-value">Natural</output></label>
              <div class="dye-tone-track"><span>Black</span><input id="dye-tone" type="range" min="-100" max="100" step="1" value="0"><span>White</span></div>
              <div class="dye-finishes">
                <button type="button" class="dye-fin" data-recipe="steel"><span class="dye-fin-swatch dye-fin-steel"></span><span>Forged steel</span></button>
                <button type="button" class="dye-fin" data-recipe="bronze"><span class="dye-fin-swatch dye-fin-bronze"></span><span>Aged bronze</span></button>
                <button type="button" class="dye-fin" data-recipe="gold"><span class="dye-fin-swatch dye-fin-gold"></span><span>Royal gold</span></button>
                <button type="button" class="dye-fin dye-default" data-recipe="none"><span class="dye-fin-swatch dye-fin-default">↺</span><span>Restore default</span></button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <% const dyeClient = {
      token: player.auth_token,
      base: dye.base,
      slotmap: dye.slotmap,
      channels: dye.channels,
      config: dye.config,
      presets: dye.presets,
      wheelSat: dye.wheelSat,
      revisionSession: dye.revisionSession,
      revisionSeed: dye.revisionSeed,
    }; %>
    <script>window.__DYE__ = <%- JSON.stringify(dyeClient).replace(/</g, '\\u003c') %>;</script>
    <script src="/static/dye-color.js"></script>
    <script src="/static/dye-draft.js"></script>
    <script src="/static/dye.js"></script>
  <% } %>
</div>
<% } %>

<div class="panel">
  <h2>Your setup snippet</h2>
  <pre><%= snippet %></pre>
</div>

<div class="panel">
  <h2>Rename</h2>
  <form method="post" action="/character/rename">
    <input type="hidden" name="token" value="<%= player.auth_token %>" />
    <label for="name">New name</label>
    <input id="name" name="name" maxlength="40" value="<%= player.name %>" required />
    <button type="submit">Rename</button>
  </form>
</div>

<div class="panel">
  <h2>Delete character</h2>
  <p style="color:var(--muted)">This permanently removes your character and its progress.</p>
  <form method="post" action="/character/delete"
        onsubmit="return confirm('Delete this character permanently?');">
    <input type="hidden" name="token" value="<%= player.auth_token %>" />
    <button type="submit" class="btn-danger">Delete</button>
  </form>
</div>
