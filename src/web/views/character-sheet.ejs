<div class="player-hub-shell">
  <section class="panel hub-hero" aria-labelledby="hub-player-name">
    <div class="hub-hero-grid">
      <div class="hub-avatar-wrap">
        <div class="character-avatar sprite-anim">
          <button type="button" class="hub-avatar-trigger"
            aria-label="View active effects" aria-controls="hub-effects" aria-expanded="false">
            <img id="character-avatar-a" src="<%= avatarA %>" alt="<%= player.name %>" class="px frame-a" />
            <img id="character-avatar-b" src="<%= avatarB %>" alt="" class="px frame-b" />
          </button>
        </div>
        <aside id="hub-effects" class="hub-effects" hidden aria-label="Active Effects">
          <h2>Active Effects</h2>
          <p><%= effects.length === 0 ? 'No magic is clinging to you right now.' : effects.length + ' effect' + (effects.length === 1 ? '' : 's') + ' currently active.' %></p>
        </aside>
      </div>
      <div class="hub-identity">
        <h1 id="hub-player-name"><%= player.name %></h1>
        <p><strong><%= className %></strong> · <%= player.gender === 'M' ? 'Male' : 'Female' %> · <%= connected ? 'Connected' : 'Not seen yet' %></p>
      </div>
      <a class="btn btn-gold character-store" href="/shop?token=<%= encodeURIComponent(player.auth_token) %>" data-dye-guarded-nav>
        <span aria-hidden="true">✦</span><span>Store</span>
      </a>
    </div>
    <div class="hub-stats" aria-label="Character stats">
      <div class="hub-stat"><span class="hub-stat-label">Level</span><span class="hub-stat-value"><%= player.level %></span></div>
      <div class="hub-stat"><span class="hub-stat-label">XP</span><span class="hub-stat-value"><%= player.effective_tokens.toLocaleString('en-US') %></span></div>
      <div class="hub-stat"><span class="hub-stat-label">Total tokens</span><span class="hub-stat-value"><%= player.total_tokens.toLocaleString('en-US') %></span></div>
      <div class="hub-stat hub-stat-gold"><span class="hub-stat-label">Gold</span><span class="hub-stat-value"><%= gold.toLocaleString('en-US') %></span></div>
    </div>
  </section>

  <div class="hub-tabs" role="tablist" aria-label="Character sections">
    <button id="hub-tab-live" role="tab" aria-selected="true" class="hub-tab" type="button" aria-controls="hub-live" tabindex="0">Live Dungeon</button>
    <button id="hub-tab-inventory" role="tab" aria-selected="false" class="hub-tab" type="button" aria-controls="hub-inventory" tabindex="-1">Inventory</button>
    <button id="hub-tab-wardrobe" role="tab" aria-selected="false" class="hub-tab" type="button" aria-controls="hub-wardrobe" tabindex="-1">Wardrobe</button>
  </div>

  <section id="hub-live" role="tabpanel" class="panel hub-panel" aria-labelledby="hub-tab-live">
    <%- include('character-live') %>
  </section>
  <section id="hub-inventory" role="tabpanel" hidden class="panel hub-panel" aria-labelledby="hub-tab-inventory">
    <%- include('character-inventory') %>
  </section>
  <section id="hub-wardrobe" role="tabpanel" hidden class="hub-panel" aria-labelledby="hub-tab-wardrobe">
    <%- include('character-wardrobe') %>
  </section>

  <details class="hub-character-settings">
    <summary>Character settings</summary>
    <div class="hub-settings-grid">
      <section class="hub-settings-card">
        <h2>Your setup snippet</h2>
        <pre><%= snippet %></pre>
      </section>
      <section class="hub-settings-card">
        <h2>Rename</h2>
        <form method="post" action="/character/rename">
          <input type="hidden" name="token" value="<%= player.auth_token %>" />
          <label for="name">New name</label>
          <input id="name" name="name" maxlength="40" value="<%= player.name %>" required />
          <button type="submit">Rename</button>
        </form>
      </section>
      <section class="hub-settings-card hub-delete">
        <h2>Delete character</h2>
        <p style="color:var(--muted)">This permanently removes your character and its progress.</p>
        <form method="post" action="/character/delete" onsubmit="return confirm('Delete this character permanently?');">
          <input type="hidden" name="token" value="<%= player.auth_token %>" />
          <button type="submit" class="btn-danger">Delete</button>
        </form>
      </section>
    </div>
  </details>
</div>

<% const playerHubState = { gold, inventory, effects, today, currentFight }; %>
<% const playerHubClient = {
  token: player.auth_token,
  initialState: playerHubState,
  endpoints: {
    state: '/character/state?token=' + encodeURIComponent(player.auth_token),
    activate: '/character/potions/activate',
  },
}; %>
<script>window.__PLAYER_HUB__ = <%- JSON.stringify(playerHubClient).replace(/</g, '\\u003c') %>;</script>
<script src="/static/player-hub.js"></script>
<script type="module">import { start } from '/static/anim.js'; start({ periodMs: 700 });</script>
