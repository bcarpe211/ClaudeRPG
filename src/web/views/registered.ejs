<div class="panel">
  <h1>Welcome, Raider <%= player.name %>!</h1>
  <p>Your class: <strong style="color:var(--gold2)"><%= className %></strong></p>

  <label style="margin-top:4px">Raider Key — your private sign-in key. Keep it safe.</label>
  <pre><%= player.auth_token %></pre>

  <label>Install the private local companion</label>
  <pre class="install-command"><%= installCommand %></pre>
  <label>One-time enrollment code — enter this at the installer's private prompt</label>
  <pre class="enrollment-code"><%= oneTimeCode %></pre>
  <p class="fine">The code expires in 10 minutes. It is separate from the command and is not your Raider Key.</p>

  <div class="flash" style="border-color:var(--gold-dim);background:linear-gradient(180deg,#26200f,#1b1712);color:#efe4c9">
    <p><code>raiders on</code> resumes collection.</p>
    <p><code>raiders off</code> pauses collection.</p>
    <p><code>raiders status</code> reports your current state and supported surfaces.</p>
    <p><code>raiders doctor</code> diagnoses setup without exporting secrets or content.</p>
    <p><code>raiders uninstall</code> stops and removes only Runtime Raiders-owned companion files.</p>
  </div>

  <a class="btn" href="/character?token=<%= encodeURIComponent(player.auth_token) %>">Open your Raider Hub →</a>
</div>
