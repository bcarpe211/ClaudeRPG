<% function durationLabel(ms) {
  if (ms % 3600000 === 0) { const n = ms / 3600000; return n + ' active ' + (n === 1 ? 'hour' : 'hours'); }
  if (ms % 60000 === 0) { const n = ms / 60000; return n + ' active ' + (n === 1 ? 'minute' : 'minutes'); }
  const n = ms / 1000; return n + ' active ' + (n === 1 ? 'second' : 'seconds');
} %>
<div class="hub-panel-head">
  <div><h2>Inventory</h2><p>Pack light, choose carefully, and keep future treasures in one place.</p></div>
</div>
<div class="hub-inventory-filters" aria-label="Inventory filters">
  <button id="hub-filter-all" type="button" class="hub-filter" data-filter="all" aria-pressed="true">All</button>
  <button id="hub-filter-potions" type="button" class="hub-filter" data-filter="potions" aria-pressed="false">Potions</button>
  <button type="button" class="hub-filter" aria-pressed="false" disabled>Materials</button>
  <button type="button" class="hub-filter" aria-pressed="false" disabled>Quest</button>
</div>
<div class="hub-inventory-layout">
  <div class="hub-inventory-room">
    <div class="hub-room-tiles" aria-hidden="true">
      <% for (let tileIndex = 0; tileIndex < 54; tileIndex += 1) { %>
        <span class="hub-room-tile"></span>
      <% } %>
    </div>
    <div id="hub-inventory-grid" class="hub-inventory-grid" aria-label="Owned items">
      <% for (let cellIndex = 0; cellIndex < 28; cellIndex += 1) { %>
        <% const cellItem = inventory[cellIndex]; %>
        <div class="hub-inventory-cell">
          <% if (cellItem) { %>
          <button type="button" class="hub-item-slot" data-sku="<%= cellItem.sku %>"
            aria-label="<%= cellItem.name %>, <%= cellItem.quantity %> owned"
            aria-pressed="<%= cellIndex === 0 ? 'true' : 'false' %>">
            <img class="hub-item-icon <%= cellItem.iconClass %>" src="/static/landing/potion.png" alt="" />
            <span class="hub-item-qty" aria-hidden="true"><%= cellItem.quantity %></span>
          </button>
          <% } %>
        </div>
      <% } %>
      <% if (inventory.length === 0) { %>
        <div class="hub-satchel-empty"><strong>Your satchel is quiet.</strong><span>Purchased supplies will settle into these floor spaces.</span></div>
      <% } %>
    </div>
  </div>
  <aside id="hub-item-detail" class="hub-item-detail" aria-live="polite" data-selected-sku="<%= inventory[0]?.sku ?? '' %>">
    <p id="hub-item-detail-empty" class="hub-empty-line" <%= inventory.length > 0 ? 'hidden' : '' %>>Select an owned item to read its ledger entry.</p>
    <div id="hub-item-detail-content" <%= inventory.length === 0 ? 'hidden' : '' %>>
      <% const item = inventory[0]; %>
      <div class="hub-item-detail-head">
        <img id="hub-item-detail-icon" class="hub-item-icon <%= item?.iconClass ?? '' %>" src="/static/landing/potion.png" alt="" />
        <div><span id="hub-item-detail-tier" class="hub-item-tier"><%= item ? `Tier ${item.tier} potion` : '' %></span><h3 id="hub-item-detail-name"><%= item?.name ?? '' %></h3></div>
      </div>
      <dl>
        <dt>Owned</dt><dd id="hub-item-detail-owned"><%= item?.quantity ?? 0 %></dd>
        <dt>Effect</dt><dd id="hub-item-detail-effect"><%= item?.effectCopy ?? '' %></dd>
        <dt>Duration</dt><dd id="hub-item-detail-duration"><%= item ? (item.available ? durationLabel(item.durationMs) : 'Unavailable until tuning is repaired') : '' %></dd>
        <dt>Doses today</dt><dd id="hub-item-detail-doses"><%= item ? (item.available ? `${item.usesRemaining} remaining` : 'Unavailable until tuning is repaired') : '' %></dd>
        <dt>Daily reset</dt><dd id="hub-item-detail-reset"><%= item ? new Date(item.nextResetAt).toLocaleString('en-US', { hour: 'numeric', minute: '2-digit' }) : '' %></dd>
      </dl>
      <div id="hub-item-active-progress" class="hub-item-active-progress" hidden></div>
      <button id="hub-potion-drink" type="button" class="btn btn-gold" <%= item?.available ? '' : 'disabled' %>><%= item && !item.available ? 'Potion Unavailable' : 'Drink Potion' %></button>
    </div>
  </aside>
</div>
